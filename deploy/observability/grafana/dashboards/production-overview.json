{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Platform availability",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"ingot-platform\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "PostgreSQL availability",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "targets": [{ "expr": "pg_up", "refId": "A" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Active alerts",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "targets": [{ "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Accepted production events / second",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [{ "expr": "sum by (edge) (rate(event_ingest_total[5m]))", "legendFormat": "{{edge}}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Edge outbox backlog",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [{ "expr": "event_outbox_backlog", "legendFormat": "{{edge}}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Sequence gaps",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [{ "expr": "increase(edge_seq_gap_detected_total[5m])", "legendFormat": "{{edge}}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Event shipping failures",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [{ "expr": "increase(event_ship_failures_total[5m])", "legendFormat": "{{edge}}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Freshness evaluation p95",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 21 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(ingot_edge_task_freshness_evaluation_duration_seconds_bucket[5m])))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Freshness evaluation errors (1h)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 21 },
      "targets": [{ "expr": "sum(increase(ingot_edge_task_freshness_evaluation_errors_total[1h])) or vector(0)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Age of latest freshness evaluation",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 21 },
      "targets": [{ "expr": "time() - ingot_edge_task_freshness_last_success_timestamp_seconds", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Freshness workload per pass",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "targets": [
        { "expr": "ingot_edge_task_freshness_last_evaluated_edges", "legendFormat": "Edges", "refId": "A" },
        { "expr": "ingot_edge_task_freshness_last_evaluated_tasks", "legendFormat": "Tasks", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Freshness transitions per pass",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "targets": [{ "expr": "ingot_edge_task_freshness_last_transitions", "legendFormat": "Transitions", "refId": "A" }]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["ingot", "production"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Ingot production overview",
  "uid": "ingot-production-overview",
  "version": 2
}

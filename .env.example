# Required by docker-compose.app.yml
INGOT_POSTGRES_PASSWORD=change-this-database-password
INGOT_ASPNETCORE_ENVIRONMENT=Production
INGOT_ACQUISITION_ENABLED=true
INGOT_SITE_ID=SITE-FACTORY-001
INGOT_EDGE_ID=EDGE-FACTORY-001
INGOT_EDGE_TOKEN=change-this-edge-ingest-token
INGOT_CONNECTOR_TOKEN=change-this-connector-ingest-token
INGOT_CONNECTOR_LOCAL_TOKEN=change-this-connector-local-api-token
INGOT_EDGE_DIAGNOSTICS_BASE_URL=http://connector-host:8001

# Optional local account seed. Leave the password empty to generate a random one on first start.
INGOT_ADMIN_USERNAME=admin
INGOT_ADMIN_PASSWORD=

# Optional runtime tuning
# Local authentication is the safe production-compatible default. Use Oidc when an external IdP is configured.
INGOT_AUTH_MODE=Local
INGOT_AUTHORITY=
INGOT_AUDIENCE=
INGOT_AUTH_REQUIRE_HTTPS=true
INGOT_OIDC_CLIENT_ID=
INGOT_OIDC_SCOPE=openid profile
INGOT_OIDC_NAME_CLAIM_TYPE=name
INGOT_OIDC_ROLE_CLAIM_TYPE=roles
# Space-separated HTTPS origins for OIDC discovery, token exchange, and silent renewal; no wildcards or paths.
INGOT_OIDC_ALLOWED_ORIGINS=
# Disabled is only permitted for an explicitly isolated demo deployment.
INGOT_ALLOW_INSECURE_DEMO=false
INGOT_OPTIMIZER_ENABLED=true
INGOT_OPTIMIZER_TIMEOUT_SECONDS=300
# Keep retention disabled until archived copies and destructive-policy recovery are accepted.
INGOT_EVENT_RETENTION_DAYS=0
# 0 keeps ingest idempotency keys indefinitely; any finite value must cover the maximum Edge replay window.
INGOT_EVENT_KEY_RETENTION_DAYS=0

# Configure the model service connection and API key in System Administration > Model Services.
# These values control Chat runtime limits and data access, not the model-service connection.
INGOT_CHAT_PROBE_ON_STARTUP=true
INGOT_CHAT_PROBE_TIMEOUT_SECONDS=10
INGOT_CHAT_ENABLE_COMBINED_ANALYSIS=false
INGOT_CHAT_MAX_TOOL_CALLS=8
INGOT_CHAT_MAX_RUN_SECONDS=60
INGOT_CHAT_MAX_DISCUSSION_ROUNDS=3
INGOT_CHAT_MAX_DISCUSSION_TURNS=9
INGOT_CHAT_OPERATOR_ALLOW_ALL=true

# Production acceptance targets. These are declarations, not evidence of acceptance.
# scripts/verify-production-acceptance.sh requires measured results and emits a reviewable artifact.
INGOT_TARGET_RPO_MINUTES=15
INGOT_TARGET_RTO_MINUTES=60
INGOT_MAX_EDGE_OFFLINE_HOURS=24
INGOT_MAX_BACKLOG_AGE_SECONDS=900
INGOT_PEAK_EVENT_RATE_PER_SECOND=1000
INGOT_PEAK_SAMPLE_POINTS_PER_SECOND=15000
# Production capacity evidence must exercise at least twice the declared peak.
INGOT_CAPACITY_TEST_MULTIPLIER_PERCENT=200
INGOT_REQUIRED_OBSERVATION_HOURS=168

# Optional local observability profile. Replace before enabling --profile monitoring.
INGOT_GRAFANA_ADMIN_USER=admin
INGOT_GRAFANA_ADMIN_PASSWORD=change-this-grafana-admin-password
INGOT_PROMETHEUS_RETENTION=30d
# Mount a site-owned routing configuration before production acceptance.
INGOT_ALERTMANAGER_CONFIG_PATH=./deploy/observability/alertmanager.yml

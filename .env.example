# Required by docker-compose.app.yml
INGOT_POSTGRES_PASSWORD=change-this-database-password
INGOT_EDGE_ID=EDGE-FACTORY-001
INGOT_EDGE_TOKEN=change-this-edge-ingest-token
INGOT_CONNECTOR_TOKEN=change-this-connector-ingest-token
INGOT_CONNECTOR_LOCAL_TOKEN=change-this-connector-local-api-token

# Optional local account seed. Leave the password empty to generate a random one on first start.
INGOT_ADMIN_USERNAME=admin
INGOT_ADMIN_PASSWORD=

# Optional runtime tuning
# Local authentication is the safe production-compatible default. Use Oidc when an external IdP is configured.
INGOT_AUTH_MODE=Local
# Disabled is only permitted for an explicitly isolated demo deployment.
INGOT_ALLOW_INSECURE_DEMO=false
INGOT_SCHEMA_MANAGEMENT=Migrations
INGOT_OPTIMIZER_ENABLED=true
INGOT_OPTIMIZER_TIMEOUT_SECONDS=300

# Optional local OpenAI-compatible model service (Qwen/DeepSeek/etc.)
# Enable only after the service exposes both configured model IDs under /v1/models.
INGOT_CHAT_ENABLED=false
INGOT_CHAT_PROVIDER=OpenAI
INGOT_CHAT_BASE_URL=http://model-host:8000/v1
INGOT_CHAT_FAST_MODEL=qwen-fast
INGOT_CHAT_REASONING_MODEL=deepseek-reasoning
INGOT_CHAT_PROBE_ON_STARTUP=true
OPENAI_API_KEY=replace-with-local-service-token

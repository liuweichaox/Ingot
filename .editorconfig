root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{js,jsx,mjs,cjs,json,jsonc,css,scss,html,yml,yaml,sh}]
indent_style = space
indent_size = 2

[*.{csproj,props,targets,xml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

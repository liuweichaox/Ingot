<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Ingot.Platform.Application.Inspections" />
    <Using Include="Ingot.Platform.Application.TimeSeries" />
  </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\agent\Ingot.Agent\Ingot.Agent.csproj" />

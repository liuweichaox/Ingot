         carries GHSA-q939-rpr3-3284 (high-severity path traversal). Testcontainers 4.13.0
         is already the latest release, so pin the patched SSH.NET to override it. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\edge\Ingot.Edge.Application\Ingot.Edge.Application.csproj" />
    <ProjectReference Include="..\..\src\shared\Ingot.Domain\Ingot.Domain.csproj" />
    <ProjectReference Include="..\..\src\shared\Ingot.Agent.Contracts\Ingot.Agent.Contracts.csproj" />
    <ProjectReference Include="..\..\src\shared\Ingot.Contracts\Ingot.Contracts.csproj" />
    <ProjectReference Include="..\..\src\edge\Ingot.Edge.Infrastructure\Ingot.Edge.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\platform\Ingot.Platform.Application\Ingot.Platform.Application.csproj" />
    <ProjectReference Include="..\..\src\platform\Ingot.Platform.Inspections.Infrastructure\Ingot.Platform.Inspections.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\platform\Ingot.Platform.Infrastructure\Ingot.Platform.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\edge\Ingot.Edge.ConnectorHost\Ingot.Edge.ConnectorHost.csproj" />
    <ProjectReference Include="..\..\src\platform\Ingot.Platform.Api\Ingot.Platform.Api.csproj" />
    <ProjectReference Include="..\..\tools\Ingot.ImportCli\Ingot.ImportCli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\contract-fixtures\optimizer-suggestion-response.json"
          Link="contract-fixtures\optimizer-suggestion-response.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

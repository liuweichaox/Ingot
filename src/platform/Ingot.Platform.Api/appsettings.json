{
  "Urls": "http://localhost:8000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Platform": {
    "DatabasePath": "Data/platform.db"
  },
  "ConnectionStrings": {
    "Events": ""
  },
  "EventIngest": {
    "RequireToken": true,
    "EdgeTokens": {},
    "MaxFutureSkewMinutes": 60,
    "MaxPastDays": 3650,
    "ChunkTimeInterval": "30 days",
    "RetentionDays": 0,
    "CompressAfterDays": 0
  },
  "InspectionAttachments": {
    "RootPath": "Data/inspection-attachments",
    "ArchiveRootPath": "",
    "MaxFileBytes": 26214400
  },
  "ProcessKnowledge": {
    "RootPath": "Data/process-knowledge",
    "ArchiveRootPath": "",
    "MaxFileBytes": 52428800
  },
  "ProcessOptimizer": {
    "Enabled": false,
    "BaseUrl": "http://127.0.0.1:8100",
    "RequestTimeoutSeconds": 300
  },
  "KnowledgeExtraction": {
    "Vision": {
      "Endpoint": "",
      "ApiKey": ""
    }
  },
  "Authentication": {
    "Mode": "Local",
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true,
    "Local": {
      "SessionLifetimeHours": 12,
      "SeedAdminUsername": "",
      "SeedAdminPassword": ""
    }
  },
  "Chat": {
    "DatabasePath": "Data/chat.db",
    "Enabled": false,
    "Provider": "Deterministic",
    "FastModel": "deterministic-v1",
    "ReasoningModel": "deterministic-v1",
    "MaxToolCalls": 8,
    "MaxRunSeconds": 60,
    "EnableCombinedAnalysis": false,
    "MaxDiscussionRounds": 3,
    "MaxDiscussionTurns": 9,
    "ModelPricing": {}
  },
  "ChatDataAccess": {
    "Users": {
      "operator": {
        "AllowAll": true,
        "EdgeIds": []
      }
    }
  },
  "Frontend": {
    "BaseUrl": ""
  },
  "CaseLeveling": {
    "WindowDays": 14,
    "MinPairingRate": 0.95,
    "MaxContextMissingRate": 0.05,
    "MinFeaturedCycles": 1,
    "MinPhaseCoverage": 0.90,
    "MinComparableCycles": 30
  },
  "AllowedHosts": "*"
}
